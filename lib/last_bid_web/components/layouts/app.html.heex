<header class="sticky top-0 z-50 bg-terminal-surface border-b border-terminal-border backdrop-blur-sm">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-7 h-7 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center group-hover:border-emerald-500/60 transition-colors">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
          <polyline points="16 7 22 7 22 13"/>
        </svg>
      </div>
      <span class="font-mono font-bold text-emerald-400 tracking-tight text-sm group-hover:text-glow-emerald transition-all">DARK POOL</span>
    </a>

    <nav class="flex items-center gap-1">
      <%= if @current_user do %>
        <a href="/lobby" class="flex items-center gap-1.5 px-3 py-1.5 rounded text-xs text-gray-400 hover:text-gray-100 hover:bg-white/5 transition-colors font-mono">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
          LOBBY
        </a>
        <div class="w-px h-4 bg-terminal-border mx-1"></div>
        <div class="flex items-center gap-2 px-3 py-1.5 rounded bg-terminal-surface2 border border-terminal-border">
          <div class="w-2 h-2 rounded-full bg-emerald-400 pulse-dot"></div>
          <span class="text-xs font-mono text-gray-300"><%= @current_user.username %></span>
        </div>
        <form action="/users/logout" method="post" class="ml-1">
          <input type="hidden" name="_method" value="delete" />
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <button type="submit" class="btn-ghost text-xs py-1.5 px-2.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
          </button>
        </form>
      <% else %>
        <a href="/users/login" class="btn-ghost text-xs">Sign in</a>
        <a href="/users/register" class="btn-primary text-xs py-1.5 px-3">
          Register
        </a>
      <% end %>
    </nav>
  </div>
</header>

<main class="max-w-screen-xl mx-auto px-4 sm:px-6 py-6">
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div class="mb-4 flex items-center gap-3 p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 text-sm fade-in-up">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/>
      </svg>
      <%= Phoenix.Flash.get(@flash, :info) %>
    </div>
  <% end %>
  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div class="mb-4 flex items-center gap-3 p-3 rounded-lg bg-red-500/10 border border-red-500/25 text-red-300 text-sm fade-in-up">
      <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/>
      </svg>
      <%= Phoenix.Flash.get(@flash, :error) %>
    </div>
  <% end %>
  <%= @inner_content %>
</main>
