<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center -mt-6 fade-in">
  <div class="w-full max-w-sm">
    <!-- Logo -->
    <div class="text-center mb-8">
      <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center mx-auto mb-4 glow-emerald">
        <svg class="w-6 h-6 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
          <polyline points="16 7 22 7 22 13"/>
        </svg>
      </div>
      <h1 class="font-mono font-bold text-white text-lg tracking-tight">DARK POOL</h1>
      <p class="text-gray-500 text-xs mt-1">Market Warfare</p>
    </div>

    <div class="card glow-emerald p-6">
      <h2 class="font-mono font-semibold text-white mb-5">Sign in</h2>

      <%= if @error_message do %>
        <div class="mb-4 flex items-center gap-2 p-3 rounded-lg bg-red-500/10 border border-red-500/25 text-red-300 text-xs font-mono">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/>
          </svg>
          <%= @error_message %>
        </div>
      <% end %>

      <.form :let={_f} for={%{}} action={~p"/users/login"} as={:user} class="space-y-4">
        <div>
          <label class="block text-xs font-mono font-semibold text-gray-400 uppercase tracking-widest mb-1.5">Email</label>
          <input type="email" name="user[email]" id="user_email"
                 class="terminal-input"
                 placeholder="you@example.com"
                 autocomplete="email"
                 required />
        </div>
        <div>
          <label class="block text-xs font-mono font-semibold text-gray-400 uppercase tracking-widest mb-1.5">Password</label>
          <input type="password" name="user[password]" id="user_password"
                 class="terminal-input"
                 placeholder="••••••••••••"
                 autocomplete="current-password"
                 required />
        </div>
        <button type="submit" class="btn-primary w-full py-2.5 mt-1">
          Sign in
        </button>
      </.form>
    </div>

    <p class="mt-4 text-center text-xs text-gray-500">
      No account?
      <a href={~p"/users/register"} class="text-emerald-400 hover:text-emerald-300 transition-colors">Register here</a>
    </p>
  </div>
</div>
