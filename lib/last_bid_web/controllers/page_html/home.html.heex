<div class="relative min-h-[calc(100vh-3.5rem)] flex flex-col items-center justify-center overflow-hidden -mt-6 -mx-4 sm:-mx-6 px-4">

  <!-- Animated grid overlay -->
  <div class="absolute inset-0 bg-hero-grid pointer-events-none"></div>

  <!-- Glowing orb -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-emerald-500/5 blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full bg-emerald-500/8 blur-2xl pointer-events-none"></div>

  <!-- Floating price tickers (decoration) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden select-none" aria-hidden="true">
    <div class="absolute top-[15%] left-[8%] font-mono text-xs text-emerald-500/20 float" style="animation-delay:0s">APEX +2.4%</div>
    <div class="absolute top-[25%] right-[10%] font-mono text-xs text-red-500/20 float" style="animation-delay:0.7s">NEXC -1.8%</div>
    <div class="absolute top-[65%] left-[12%] font-mono text-xs text-emerald-500/15 float" style="animation-delay:1.2s">VRTX +5.1%</div>
    <div class="absolute top-[70%] right-[8%] font-mono text-xs text-red-500/15 float" style="animation-delay:0.4s">LMNA -3.2%</div>
    <div class="absolute top-[45%] left-[3%] font-mono text-xs text-cyan-500/15 float" style="animation-delay:1.8s">STRF +0.9%</div>
    <div class="absolute top-[40%] right-[4%] font-mono text-xs text-cyan-500/15 float" style="animation-delay:0.9s">BID: 128.50</div>
  </div>

  <!-- Hero content -->
  <div class="relative z-10 text-center max-w-3xl fade-in-up">
    <!-- Logo mark -->
    <div class="flex justify-center mb-6">
      <div class="w-16 h-16 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center float glow-emerald">
        <svg class="w-8 h-8 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
          <polyline points="16 7 22 7 22 13"/>
        </svg>
      </div>
    </div>

    <h1 class="text-5xl sm:text-7xl font-bold font-mono tracking-tight mb-4">
      <span class="text-emerald-400 text-glow-emerald">DARK</span>
      <span class="text-white"> POOL</span>
    </h1>

    <p class="text-lg sm:text-xl text-gray-400 mb-3 font-mono">
      A multiplayer market-warfare game.
    </p>
    <p class="text-gray-500 mb-10 max-w-xl mx-auto leading-relaxed">
      Manipulate prices. Leak intel. Freeze rivals. 4 players, 8 rounds, one winner.
      Server-authoritative. Information asymmetry is the weapon.
    </p>

    <%= if @current_user do %>
      <a href="/lobby" class="btn-primary text-base px-8 py-3 glow-emerald">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
        </svg>
        Enter the Lobby
      </a>
    <% else %>
      <div class="flex gap-3 justify-center">
        <a href="/users/register" class="btn-primary text-base px-8 py-3 glow-emerald">
          Get Started
        </a>
        <a href="/users/login" class="btn-ghost text-base px-8 py-3">
          Sign in
        </a>
      </div>
    <% end %>
  </div>

  <!-- Feature grid -->
  <div class="relative z-10 mt-16 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl w-full px-4 fade-in-up" style="animation-delay:0.15s">
    <div class="card p-4 text-center card-hover">
      <div class="text-2xl mb-2">📈</div>
      <div class="text-xs font-mono text-gray-400">Market Manipulation</div>
    </div>
    <div class="card p-4 text-center card-hover">
      <div class="text-2xl mb-2">🕵️</div>
      <div class="text-xs font-mono text-gray-400">Intel Leaks</div>
    </div>
    <div class="card p-4 text-center card-hover">
      <div class="text-2xl mb-2">🧊</div>
      <div class="text-xs font-mono text-gray-400">Liquidity Freeze</div>
    </div>
    <div class="card p-4 text-center card-hover">
      <div class="text-2xl mb-2">⚖️</div>
      <div class="text-xs font-mono text-gray-400">Regulatory Heat</div>
    </div>
  </div>
</div>
