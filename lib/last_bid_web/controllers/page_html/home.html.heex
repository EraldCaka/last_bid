<div class="text-center py-20">
  <h1 class="text-5xl font-bold text-emerald-400 mb-4">Dark Pool</h1>
  <p class="text-xl text-gray-400 mb-8">A multiplayer market-warfare game.</p>
  <p class="text-gray-500 mb-8">Manipulate prices. Control narratives. Outmaneuver rivals.</p>
  <%= if @current_user do %>
    <a href="/lobby" class="bg-emerald-600 hover:bg-emerald-500 px-6 py-3 rounded-lg text-white font-semibold text-lg">
      Enter the Lobby
    </a>
  <% else %>
    <div class="flex gap-4 justify-center">
      <a href="/users/register" class="bg-emerald-600 hover:bg-emerald-500 px-6 py-3 rounded-lg text-white font-semibold">
        Register
      </a>
      <a href="/users/login" class="border border-gray-600 hover:border-gray-400 px-6 py-3 rounded-lg text-gray-300 font-semibold">
        Log in
      </a>
    </div>
  <% end %>
</div>
