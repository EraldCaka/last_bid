<div class="max-w-md mx-auto fade-in-up">
  <!-- Back -->
  <a href={~p"/lobby"} class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-300 font-mono mb-6 transition-colors">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 5l-7 7 7 7"/>
    </svg>
    Back to Lobby
  </a>

  <div class="card glow-emerald p-6">
    <!-- Header -->
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center">
        <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </div>
      <div>
        <h2 class="font-bold font-mono text-white">CREATE MATCH</h2>
        <p class="text-xs text-gray-500 mt-0.5">Configure yourLast Bid session</p>
      </div>
    </div>

    <.form :let={f} for={@changeset} action={~p"/matches"} as={:match} class="space-y-5">
      <div>
        <label class="block text-xs font-mono font-semibold text-gray-400 uppercase tracking-widest mb-2">
          Match Name
        </label>
        <input type="text"
               name={f[:name].name}
               id={f[:name].id}
               value={f[:name].value || ""}
               class="terminal-input"
               placeholder="e.g. Friday NightLast Bid"
               autocomplete="off"
               required />
        <%= for {msg, _} <- Keyword.get_values(f.errors, :name) do %>
          <p class="mt-1.5 text-xs text-red-400 font-mono"><%= msg %></p>
        <% end %>
      </div>

      <!-- Match info -->
      <div class="rounded-lg bg-terminal-surface2 border border-terminal-border p-4 space-y-2">
        <div class="flex justify-between text-xs font-mono">
          <span class="text-gray-500">Max players</span>
          <span class="text-gray-300">4</span>
        </div>
        <div class="flex justify-between text-xs font-mono">
          <span class="text-gray-500">Total rounds</span>
          <span class="text-gray-300">8</span>
        </div>
        <div class="flex justify-between text-xs font-mono">
          <span class="text-gray-500">Negotiation window</span>
          <span class="text-gray-300">2 min</span>
        </div>
        <div class="flex justify-between text-xs font-mono">
          <span class="text-gray-500">Companies</span>
          <span class="text-gray-300">APEX · NEXC · VRTX · LMNA · STRF</span>
        </div>
      </div>

      <button type="submit" class="btn-primary w-full py-2.5 text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
          <polyline points="16 7 22 7 22 13"/>
        </svg>
        Launch Match
      </button>
    </.form>
  </div>
</div>
