<script>
  window.DarkPool = {
    socketToken: "<%= @socket_token %>",
    userId: "<%= @current_user.id %>"
  };
</script>

<div class="flex flex-col gap-6 fade-in">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold font-mono text-white">LOBBY</h1>
      <p class="text-xs text-gray-500 font-mono mt-0.5">
        <span id="lobby-online-count">—</span> online
      </p>
    </div>

    <a href={~p"/matches/new"} class="btn-primary text-xs">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      New Match
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <div class="lg:col-span-1">
      <div class="card p-4 sticky top-20">
        <h2 class="text-xs font-mono font-semibold text-gray-500 uppercase tracking-widest mb-3 flex items-center gap-2">
          <svg class="w-3 h-3 text-emerald-400" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="4"/>
          </svg>
          Online
        </h2>

        <div id="lobby-presence-list" class="space-y-2">
          <p class="text-xs text-gray-600 font-mono">Connecting...</p>
        </div>
      </div>
    </div>

    <div class="lg:col-span-3 space-y-6">
      <%= if length(@my_matches) > 0 do %>
        <section>
          <h2 class="text-xs font-mono font-semibold text-gray-500 uppercase tracking-widest mb-3">
            Your Matches
          </h2>

          <div class="space-y-2">
            <%= for match <- @my_matches do %>
              <a
                href={~p"/matches/#{match.id}"}
                class="card card-hover flex items-center justify-between p-4 group cursor-pointer"
              >
                <div class="flex items-center gap-3">
                  <div class={[
                    "w-2 h-2 rounded-full",
                    if(match.status == "active", do: "bg-emerald-400", else: "bg-gray-600")
                  ]}>
                  </div>

                  <div>
                    <span class="font-semibold text-sm text-white group-hover:text-emerald-300 transition-colors font-mono">
                      <%= match.name %>
                    </span>

                    <span class={[
                      "ml-2 text-xs phase-badge",
                      "phase-#{match.status}"
                    ]}>
                      <%= match.status %>
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-3 text-xs text-gray-500">
                  <span class="font-mono"><%= length(match.match_players) %>/<%= match.max_players %></span>

                  <svg class="w-4 h-4 group-hover:text-emerald-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M9 18l6-6-6-6"/>
                  </svg>
                </div>
              </a>
            <% end %>
          </div>
        </section>
      <% end %>

      <section>
        <h2 class="text-xs font-mono font-semibold text-gray-500 uppercase tracking-widest mb-3">
          Open Matches
        </h2>

        <div id="open-matches-list" class="space-y-2">
          <%= if length(@open_matches) == 0 do %>
            <div id="no-matches-placeholder" class="card p-12 text-center">
              <div class="text-4xl mb-3">📊</div>
              <p class="text-gray-500 text-sm">No open matches yet.</p>
              <p class="text-gray-600 text-xs mt-1">Create one and invite friends.</p>
            </div>
          <% else %>
            <%= for match <- @open_matches do %>
              <% already_joined = Enum.any?(@my_matches, &(&1.id == match.id)) %>

              <div class="card card-hover p-4 match-card fade-in-up" data-match-id={match.id}>
                <div class="flex items-center justify-between gap-4">
                  <a href={~p"/matches/#{match.id}"} class="flex min-w-0 flex-1 items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shrink-0">
                      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                      </svg>
                    </div>

                    <div class="min-w-0">
                      <div class="font-semibold text-sm text-white font-mono truncate">
                        <%= match.name %>
                      </div>

                      <div class="text-xs text-gray-500 mt-0.5">
                        hosted by
                        <span class="text-gray-400"><%= match.host && match.host.username %></span>
                      </div>
                    </div>
                  </a>

                  <div class="flex items-center gap-3 shrink-0">
                    <div class="text-right">
                      <div class="text-xs font-mono text-gray-400">
                        <span class="text-white font-semibold"><%= length(match.match_players) %></span>/<%= match.max_players %>
                      </div>
                      <div class="text-xs text-gray-600">players</div>
                    </div>

                    <%= if already_joined do %>
                      <a href={~p"/matches/#{match.id}"} class="btn-primary text-xs py-1.5 px-4">
                        Enter
                      </a>
                    <% else %>
                      <form action={~p"/matches/#{match.id}/join"} method="post">
                        <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />

                        <button type="submit" class="btn-primary text-xs py-1.5 px-4">
                          Join
                        </button>
                      </form>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</div>
