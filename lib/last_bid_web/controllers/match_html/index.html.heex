<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Lobby</h1>
  <a href={~p"/matches/new"} class="bg-emerald-600 hover:bg-emerald-500 px-4 py-2 rounded-lg text-white text-sm font-semibold">
    Create Match
  </a>
</div>

<%= if length(@my_matches) > 0 do %>
  <section class="mb-8">
    <h2 class="text-lg font-semibold text-gray-300 mb-3">Your Matches</h2>
    <div class="space-y-2">
      <%= for match <- @my_matches do %>
        <a href={~p"/matches/#{match.id}"} class="block bg-gray-900 border border-gray-700 rounded-lg p-4 hover:border-emerald-600 transition-colors">
          <div class="flex items-center justify-between">
            <div>
              <span class="font-medium text-white"><%= match.name %></span>
              <span class={["ml-2 text-xs px-2 py-0.5 rounded", if(match.status == "active", do: "bg-emerald-900 text-emerald-300", else: "bg-gray-800 text-gray-400")]}>
                <%= match.status %>
              </span>
            </div>
            <span class="text-sm text-gray-400">
              <%= length(match.match_players) %>/<%= match.max_players %> players
            </span>
          </div>
        </a>
      <% end %>
    </div>
  </section>
<% end %>

<section>
  <h2 class="text-lg font-semibold text-gray-300 mb-3">Open Matches</h2>
  <%= if length(@open_matches) == 0 do %>
    <div class="text-center py-12 text-gray-500">
      <p>No open matches. Be the first to create one.</p>
    </div>
  <% else %>
    <div class="space-y-2">
      <%= for match <- @open_matches do %>
        <div class="bg-gray-900 border border-gray-700 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div>
              <span class="font-medium text-white"><%= match.name %></span>
              <span class="ml-2 text-xs text-gray-500">by <%= match.host && match.host.username %></span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-sm text-gray-400"><%= length(match.match_players) %>/<%= match.max_players %></span>
              <button type="button" data-match-id={match.id} class="join-match-btn text-sm bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-white">
                Join
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
